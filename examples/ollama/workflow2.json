{
    "functions": [
    ],
    "resources": [
        {
            "name": "http-ingress",
            "class_type": "http-ingress",
            "output_mapping": {
                "new_request": "ollama"
            },
            "configurations": {
                "wf_id": "false",
                "async": "true"
            }
        },
        {
            "name": "ollama",
            "class_type": "ollama",
            "output_mapping": {
                "out": "file-log"
            },
            "configurations": {
                "model": "llama3.2-3b-fixed"
            }
        },
        {
            "name": "file-log",
            "class_type": "file-log",
            "output_mapping": {},
            "configurations": {
                "filename": "ollama.log",
                "add-timestamp": "true"
            }
        }
    ],
    "annotations": {}
}
